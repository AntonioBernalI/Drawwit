    {
      "id": "MCz_ZtZim4UctMM84_WMR",
      "type": "text",
      "x": 3491.661157526798,
      "y": 2385.8105365837364,
      "width": 508.75,
      "height": 232.6184439344048,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aAd",
      "roundness": null,
      "seed": 1826828337,
      "version": 1248,
      "versionNonce": 783648049,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794449709872,
      "created": 1794416914047,
      "link": null,
      "locked": false,
      "text": "A drawing contest based on an\nunfinished drawing template. Players\ncomplete the artwork to create a\nbrand-new, original concept. The\ndrawings are then rated by other\nplayers and ranked directly on the\npost.",
      "fontSize": 26.584965021074836,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A drawing contest based on an unfinished drawing template. Players complete the artwork to create a brand-new, original concept. The drawings are then rated by other players and ranked directly on the post.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "KU0dv-mrsrG1QdcBzYbai",
      "type": "text",
      "x": 3473.7124759949675,
      "y": 3413.632312419066,
      "width": 534.3346436634815,
      "height": 199.38723765806125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aAf",
      "roundness": null,
      "seed": 1188294303,
      "version": 1714,
      "versionNonce": 1474989535,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794449753761,
      "created": 1794417673003,
      "link": null,
      "locked": false,
      "text": "A Pixelary-like game where, instead of\nguessing a prompt, players have to guess\nthe average answer based on a scale\nprovided by the post creator. The scale\ncan be measured using natural numbers\nor text categories.",
      "fontSize": 26.584965021074836,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A Pixelary-like game where, instead of guessing a prompt, players have to guess the average answer based on a scale provided by the post creator. The scale can be measured using natural numbers or text categories.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "e21poHhKDGP7xPorDFN7J",
      "type": "text",
      "x": 3463.8326219310866,
      "y": 4429.55076358242,
      "width": 534.3346436634815,
      "height": 99.69361882903063,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aAfG",
      "roundness": null,
      "seed": 18140881,
      "version": 1922,
      "versionNonce": 1943789713,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794449811820,
      "created": 1794418344601,
      "link": null,
      "locked": false,
      "text": "A Pixelary-style game featuring wiggly\ndrawings and floating hints based on\nincorrect guesses from previous players.",
      "fontSize": 26.584965021074836,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A Pixelary-style game featuring wiggly drawings and floating hints based on incorrect guesses from previous players.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "2xGkwBhld1Xw7WRsoi7re",
      "type": "text",
      "x": 3470.9742921865454,
      "y": 4583.42002739101,
      "width": 534.3346436634815,
      "height": 132.92482510537417,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aAfO",
      "roundness": null,
      "seed": 1320598143,
      "version": 2135,
      "versionNonce": 1511479071,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794449856078,
      "created": 1794418970339,
      "link": null,
      "locked": false,
      "text": "You can also write your own custom\nprompts. Instead of just 'What is this?',\nyou can use prompts like 'Who is he?' or\n'What is he doing?",
      "fontSize": 26.584965021074836,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "You can also write your own custom prompts. Instead of just 'What is this?', you can use prompts like 'Who is he?' or 'What is he doing?",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "2tq1yMsxkLzYmXvZNLheh",
      "type": "text",
      "x": 3481.622323539247,
      "y": 3628.4672530796374,
      "width": 534.3346436634815,
      "height": 66.46241255268708,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aAfV",
      "roundness": null,
      "seed": 1143010239,
      "version": 1862,
      "versionNonce": 1839427551,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794449786027,
      "created": 1794418205835,
      "link": null,
      "locked": false,
      "text": "You get feedback about your guess, \nusing a \"hot\" or \"cold\" system. ",
      "fontSize": 26.584965021074836,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "You get feedback about your guess, \nusing a \"hot\" or \"cold\" system. ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "P740R-u6997j1rx-tFEVA",
      "type": "text",
      "x": 3496.2523348474097,
      "y": 2648.4816914322487,
      "width": 483.04443359375,
      "height": 66.46241255268708,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aAh",
      "roundness": null,
      "seed": 145614193,
      "version": 1356,
      "versionNonce": 975693521,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794449717530,
      "created": 1794417041562,
      "link": null,
      "locked": false,
      "text": "Users can create their own \"contest\"\nwith a prompt, or their own prompt.",
      "fontSize": 26.584965021074836,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Users can create their own \"contest\"\nwith a prompt, or their own prompt.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
