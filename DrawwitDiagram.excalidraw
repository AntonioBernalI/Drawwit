      "updated": 1794446932832,
      "created": 1794420155981,
      "link": null,
      "locked": false,
      "text": "Wikipedia for inspiration\n(hypercard and old Mac\nui).\n\nwiggly paint for\ninspiration about the\ncanvas and animations.\n\nexcali draw for\nwireframes and overall\nplaning.\n\npenpot for creating the\nUI and UX.\n",
      "fontSize": 30.346255437931127,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Wikipedia for inspiration (hypercard and old Mac ui).\n\nwiggly paint for inspiration about the canvas and animations.\n\nexcali draw for wireframes and overall planing.\n\npenpot for creating the UI and UX.\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
