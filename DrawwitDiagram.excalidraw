      "updated": 1794446932832,
      "created": 1794419198328,
      "link": null,
      "locked": false,
      "text": "Reddit-Devvit game inspired by pixelary, jackbox games.\nIts an UGC game, where players have different ways to\nparticipate, draw and let others interact with his drawings.\n\nThe key of drawwit lies in its humor and\nits versatility to shape its game and reach almost\nevery single community in reddit.",
      "fontSize": 31.74999999999997,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reddit-Devvit game inspired by pixelary, jackbox games.\nIts an UGC game, where players have different ways to\nparticipate, draw and let others interact with his drawings.\n\nThe key of drawwit lies in its humor and\nits versatility to shape its game and reach almost\nevery single community in reddit.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
