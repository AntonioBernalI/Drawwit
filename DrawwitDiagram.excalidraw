      "updated": 1794446208892,
      "created": 1794445847713,
      "link": null,
      "locked": false,
      "text": "Fue creado por alguien llamado\nHuckleBerry aunque actualmente\nlo mantiene reddit, y aun sin\npromocionarlo y haberlo\nabandonado, es muy popular.",
      "fontSize": 48.88,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fue creado por alguien llamado HuckleBerry aunque actualmente lo mantiene reddit, y aun sin promocionarlo y haberlo abandonado, es muy popular.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "qbBBDrbvYz-lkCSgSet3f",
      "type": "text",
      "x": 3726.742287005023,
      "y": -2268.42743759951,
      "width": 757.4625265502935,
      "height": 244.4,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1Bj",
      "roundness": null,
      "seed": 1723411889,
      "version": 1803,
      "versionNonce": 1808393009,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794446208892,
      "created": 1794446048077,
      "link": null,
      "locked": false,
      "text": "Tienen exito principalmente por\nlo versatiles que son y poderse\nadaptar a cualquier cosa que\ndibujas o escribas",
      "fontSize": 48.88,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tienen exito principalmente por lo versatiles que son y poderse adaptar a cualquier cosa que dibujas o escribas",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
